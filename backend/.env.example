# development | production | test
NODE_ENV=development

# Port the API listens on
PORT=5000

# Origin allowed by CORS. Optional in development (defaults to the Vite dev
# server); REQUIRED in production: the exact deployed frontend origin, e.g.
# https://ocr.example.com
FRONTEND_URL=http://localhost:5173

# Maximum size of each uploaded image, in megabytes (max 20)
MAX_UPLOAD_SIZE_MB=5

# OCR: parallel Tesseract workers (1-4); each uses one CPU core and up to
# ~600 MB RAM on the largest images
OCR_WORKER_COUNT=1
# OCR: max images running, waiting or reserved (each request reserves 2)
# before uploads are refused with 503 (min 2)
OCR_MAX_QUEUE=8
# OCR: per-image time limit in milliseconds, once a worker is free
OCR_TIMEOUT_MS=30000
# OCR: max time an image may wait for a free worker (>= OCR_TIMEOUT_MS;
# together with OCR_TIMEOUT_MS at most 110000, under the frontend's 120 s)
OCR_QUEUE_TIMEOUT_MS=60000
# OCR: max width or height in pixels accepted for recognition
OCR_MAX_IMAGE_DIMENSION=6000
